@* Passo 03 - Criar as Views *@
@* Se Estou na View(Index) de Produtos, qual sera a model
que devo usar????????*@
@model List<TechStoreMVC.Models.Produto>

    @{
        ViewData["Title"] = "Produtos";
   }

<h1>
    Lista de Produtos
</h1>
<table class="table table-striped">
    <thead>
        @*Cabeçalho da tabela*@
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Preco</th>
            <th>Estoque</th>
        </tr>
    </thead>
    <tbody>
        @* Imagine que a cada novo produto voce tivesse que repetir isso
        toda a vez, seriam linhas sem fim. Por isso, usamoso foreach.
        
        O Foreach repete enquanto houver produtos existentes e, se
        existir, eles serão exibidos para ti nessa tela.*@
        @foreach(var produto in Model)
        {
            <tr>
            <td>@produto.Id</td>
            <td>@produto.Nome</td>
            <td>R$ @produto.Preco.ToString("F2")</td>
            <td>@produto.Estoque</td>
            <td> 
                <button class="btn btn-primary">Detalhes</button>
            </td>
            </tr>
        }
    </tbody>

</table>